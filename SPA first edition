double initial(double yi, double sigma){
    double a, b;
    b = 2 * yi / sigma;
    a = 1.0 / (1.0 + exp(b));
    return a;
}

double cal_r_for_fnode(Alist *matrix,  int a, double caly[]){
    double b, c = 1.0; // double use 1.0 instead of integer 1
    int a_row_num = matrix->row_weight[a];
    int d;
    for(int i = 0; i < a_row_num; i ++){
        d = matrix->row_index[a][i];
        if((d-1) != a){
            b = 1.0- (2.0 * caly[d-1]);
            c *= b;
        }
    }
    return (0.5 + 0.5 * c) ;
}
